# ─── Secrets / env — NEVER commit (real money) ───────────────
.env
.env.*
*.key
*master_key*
*.pem
secrets/

# ─── Per-server runtime state & data ─────────────────────────
data/
*.db
*.db-wal
*.db-shm
*.sqlite
logs/
*.log
data/instances/
*state-export*.json
paper_state.json

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# ─── Backups / archives ──────────────────────────────────────
*.tar.gz
*.tgz
*-BACKUP-*
*-PREAUDIT-*
*-PREWEBPANEL-*

